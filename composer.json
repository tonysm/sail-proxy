{
    "name": "tonysm/sail-proxy",
    "description": "Serve your local Laravel Sail apps on real hostnames.",
    "keywords": [
        "laravel",
        "sail",
        "docker",
        "proxy",
        "cli",
        "console"
    ],
    "homepage": "https://github.com/tonysm/sail-proxy",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/tonysm/sail-proxy/issues",
        "source": "https://github.com/tonysm/sail-proxy"
    },
    "authors": [
        {
            "name": "Tony Messias",
            "email": "tonyzrp@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0",
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8 || ^5.0.3",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "builds/sail-proxy"
    ]
}
